# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://milanote:milanote@localhost:5432/milanote?schema=public"

# ── Auth.js ─────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""

# Magic-link email transport (local dev → Maildev, see docker-compose.yml)
# Web inbox at http://localhost:1080 — every "sent" magic link lands here.
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="noreply@milanote-os.local"

# ── Realtime sync (server/sync-server.ts) ───────────────────
# Standalone WebSocket process, run alongside `next dev`. Persists board
# canvases to the BoardDoc table (see Prisma schema).
SYNC_SERVER_PORT="5858"
NEXT_PUBLIC_SYNC_SERVER_URL="ws://localhost:5858"
# Localhost-only endpoint used by /api/clip (browser clipper) to inject a
# shape into a live room. Generate with: openssl rand -hex 24
SYNC_INTERNAL_PORT="5859"
SYNC_INTERNAL_SECRET=""

# ── Object storage (MinIO, S3-compatible) ──────────────────
# Not wired into app code yet (future file-upload slice) — provisioned now
# so the docker-compose stack is complete.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="milanote-os"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
